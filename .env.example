# UDP listener used for ticket granting.
SONIC_AUTHENTICATION_SERVER_PORT=60000

# UDP listener used for the secure game server.
SONIC_SECURE_SERVER_PORT=60001

# Public IP address or hostname reachable by Wii U consoles.
SONIC_SECURE_SERVER_HOST=127.0.0.1

# Public game-specific NEX access key. Normally this should not be changed.
SONIC_ACCESS_KEY=b26a3421

# Internal password shared by the two server-side Quazal accounts.
SONIC_KERBEROS_PASSWORD=change-me

# Optional JSON map of PID to NEX password. See accounts.example.json.
SONIC_ACCOUNTS_FILE=

# Hex-encoded random secret shared with the account server. Generate one with:
#   openssl rand -hex 32
SONIC_ACCOUNT_SECRET=

# Keep false on public deployments unless the account-server integration is
# configured with the same SONIC_ACCOUNT_SECRET.
SONIC_ALLOW_UNKNOWN_ACCOUNTS=false

SONIC_DATA_DIR=data
SONIC_ALLOW_PUBLIC_MATCHMAKING=true
SONIC_LOG_PACKETS=false

# auto, on, or off
SONIC_STRUCTURE_HEADER=auto
